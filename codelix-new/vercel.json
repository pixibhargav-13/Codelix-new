{
  "trailingSlash": false,
  "functions": {
    "api/post-page.js": { "includeFiles": "dist/{post-shell,404}.html" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.clarity.ms; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src https://www.google.com https://www.youtube-nocookie.com; media-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/:slug([a-z0-9-]+-case-study)", "destination": "/case-study/:slug", "permanent": true },
    { "source": "/terms", "destination": "/terms-of-service", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/products/4bitx", "destination": "/products/codelix-erp", "permanent": true },
    { "source": "/products", "destination": "/work", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:path+/index.html", "destination": "/:path+", "permanent": true }
  ],
  "rewrites": [
    { "source": "/media/:path*", "destination": "/api/media?path=:path*" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap-posts.xml", "destination": "/api/sitemap" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/api/post-page?type=blog&slug=:slug" },
    { "source": "/case-study/:slug", "destination": "/api/post-page?type=case&slug=:slug" }
  ]
}
